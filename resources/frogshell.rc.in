#include <windows.h>
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/branding/frogshell.ico"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "FrogShell"
      VALUE "FileDescription", "FrogShell SSH Workspace"
      VALUE "FileVersion", "@PROJECT_VERSION@.0"
      VALUE "InternalName", "RabbitShell"
      VALUE "OriginalFilename", "FrogShell.exe"
      VALUE "ProductName", "FrogShell"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
